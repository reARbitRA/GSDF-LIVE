# Copy to .env.local (git-ignored via *.local) and fill in.
# Optional. Enables "Generate with AI" and file import in Script Riter. Without it the app still
# runs; AI features show an "unavailable" message.
# WARNING: this value is compiled into the public JavaScript bundle (vite.config.ts). Use a key that
# is restricted by HTTP referrer and has a spending quota. See README "Security notes".
GEMINI_API_KEY=
